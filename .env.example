# ---- Server (Vercel -> Settings -> Environment Variables) ----
BOT_TOKEN=123456:ABC...                 # from @BotFather
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Supabase -> Settings -> API (keep secret!)
AD_REWARD_SECRET=put-a-long-random-string-here
AD_SERVER_CONFIRM=true                  # leave true in production
CHANNEL_USERNAME=@YourChannel           # optional: enables the "Join channel" task (bot must be admin of the channel)

# ---- Client (also add in Vercel; VITE_ prefix = public) ----
VITE_ADSGRAM_BLOCK_ID=12345             # digits only, the REWARD block id (no "int-")
VITE_BOT_LINK=https://t.me/BoxBlastGame_bot
VITE_APP_LINK=https://t.me/BoxBlastGame_bot/app   # BotFather /myapps direct link

# ---- Server (Vercel -> Settings -> Environment Variables) ----
BOT_TOKEN=123456:ABC...                 # from @BotFather
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Supabase -> Settings -> API (keep secret!)
AD_REWARD_SECRET=put-a-long-random-string-here
AD_SERVER_CONFIRM=true                  # leave true in production
CHANNEL_USERNAME=@YourChannel           # optional: enables the "Join channel" task (bot must be admin of the channel)

# ---- Client (also add in Vercel; VITE_ prefix = public) ----
VITE_ADSGRAM_BLOCK_ID=12345             # digits only, the REWARD block id (no "int-")
VITE_BOT_LINK=https://t.me/BoxBlastGame_bot
VITE_APP_LINK=https://t.me/BoxBlastGame_bot/app   # IMPORTANT for referrals: BotFather /myapps direct link (BOT/shortname)
VITE_CONTACT=@YourSupportUsername       # shown in the in-app guide (optional)
VITE_CHARITY_NOTE=                      # optional: only fill in if you really do it, e.g. "10% of our ad income supports families in need."

# ---- Optional (v4): bot webhook so ?start=ref_ links also work ----
WEBHOOK_SECRET=another-long-random-string

# ---- v5: ad networks ----
VITE_ADSGRAM_BLOCK_ID=55501
VITE_MONETAG_ZONE_ID=12108818
VITE_TADS_WIDGET_ID=12842
MONETAG_ZONE_ID=12108818
TADS_WIDGET_ID=12842
# AD_REWARD_SECRET (already set) is also used in the Monetag postback and the TADS webhook URLs.
